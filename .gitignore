# Credentials — the real key file never leaves this machine.
.env

# Machine-local path aliases. Same reason: true here, meaningless elsewhere.
.dependencies

# Runtime bookkeeping: slot leases, caches. Rebuildable, never authoritative.
.state/

# Per-run process markers and captured console output.
# The conversation and the deliverables ARE committed; process noise is not.
tasks/*/run/

.worktrees/
__pycache__/
*.pyc
.venv/
.DS_Store
